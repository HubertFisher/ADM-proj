# Path to the official ZIP distribution; the importer reads its CSV directly.
METROPT_INPUT_PATH=./data/metropt+3+dataset.zip

# The source timestamps contain no timezone. Set the correct operational timezone.
# UTC is shown only as an explicit example, not a fact inferred from the data.
METROPT_SOURCE_TIMEZONE=UTC
METROPT_UNIT_ID=APU_METRO_01
